# Store these values in the deployment platform's encrypted secret manager.
# Do not copy staging or development credentials into production.
NODE_ENV=production
APP_ENV=production
NEXT_PUBLIC_APP_URL=https://www.talomart.example
NEXT_PUBLIC_STORE_NAME=Talomart Stores
AUTH_SECRET=replace-with-a-unique-random-production-secret-at-least-48-characters
ADMIN_MFA_REQUIRED=true

DATABASE_URL=postgresql://PRODUCTION_RUNTIME_CONNECTION
DATABASE_DIRECT_URL=postgresql://PRODUCTION_MIGRATION_CONNECTION
SUPABASE_URL=https://PRODUCTION_PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-production-sb-secret-key
SUPABASE_STORAGE_BUCKET=product-images

MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=replace-with-production-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-production-daraja-consumer-secret
MPESA_SHORTCODE=replace-with-production-shortcode
MPESA_PASSKEY=replace-with-production-passkey
MPESA_CALLBACK_URL=https://www.talomart.example/api/payments/mpesa/callback

RESEND_API_KEY=replace-with-production-email-api-key
RESEND_WEBHOOK_SECRET=replace-with-production-webhook-signing-secret
EMAIL_FROM=Talomart Stores <orders@talomart.example>
EMAIL_REPLY_TO=support@talomart.example
CRON_SECRET=replace-with-production-cron-secret
RATE_LIMIT_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_IPS=replace-with-production-proxy-cidr
LOG_LEVEL=info
