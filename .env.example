# Application
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Talomart Stores
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_MFA_REQUIRED=true
RATE_LIMIT_IP_HEADER=x-forwarded-for
# Optional CIDRs/addresses of reverse proxies that Better Auth may trust.
TRUSTED_PROXY_IPS=

# Supabase PostgreSQL
# Runtime: Shared Pooler transaction mode, normally port 6543.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Migrations: direct connection or Shared Pooler session mode on port 5432.
DATABASE_DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Storage (server-side use only)
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Preferred current server-only key. A legacy service_role key is accepted
# temporarily, but new deployments should use SUPABASE_SECRET_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# Optional local Docker fallback
POSTGRES_DB=talomart
POSTGRES_USER=talomart
POSTGRES_PASSWORD=talomart
POSTGRES_PORT=5432

# Optional Redis/BullMQ fallback. Supabase Queues is the preferred direction.
REDIS_URL=
REDIS_PORT=6379

# Safaricom Daraja (use values from your sandbox app and M-Pesa Express simulator)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Safaricom cannot call localhost. Use an HTTPS staging deployment or tunnel.
MPESA_CALLBACK_URL=https://YOUR-PUBLIC-SANDBOX-HOST/api/payments/mpesa/callback

# Transactional email
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Must use a sender on a domain verified by the email provider.
EMAIL_FROM=Talomart Stores <accounts@example.com>
EMAIL_REPLY_TO=support@example.com
# Protects scheduled notification-delivery requests.
CRON_SECRET=

# Optional alternative object storage (Cloudflare R2 or Amazon S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=talomart-products
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
NEXT_PUBLIC_ASSET_BASE_URL=

# Observability
SENTRY_DSN=
LOG_LEVEL=info
