# Staging must use an isolated database, storage bucket and provider credentials.
NODE_ENV=production
APP_ENV=staging
NEXT_PUBLIC_APP_URL=https://staging.talomart.example
NEXT_PUBLIC_STORE_NAME=Talomart Stores Staging
AUTH_SECRET=replace-with-a-unique-random-staging-secret-at-least-48-characters
ADMIN_MFA_REQUIRED=true

DATABASE_URL=postgresql://STAGING_RUNTIME_CONNECTION
DATABASE_DIRECT_URL=postgresql://STAGING_MIGRATION_CONNECTION
SUPABASE_URL=https://STAGING_PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-with-staging-sb-secret-key
SUPABASE_STORAGE_BUCKET=staging-product-images

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=replace-with-staging-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-staging-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=replace-with-sandbox-passkey
MPESA_CALLBACK_URL=https://staging.talomart.example/api/payments/mpesa/callback

RESEND_API_KEY=replace-with-staging-email-api-key
RESEND_WEBHOOK_SECRET=replace-with-staging-webhook-signing-secret
EMAIL_FROM=Talomart Staging <staging@staging.talomart.example>
EMAIL_REPLY_TO=support@staging.talomart.example
CRON_SECRET=replace-with-staging-cron-secret
RATE_LIMIT_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_IPS=replace-with-staging-proxy-cidr
LOG_LEVEL=info
