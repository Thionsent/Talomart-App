# Local developer workstation only. Copy to .env and replace secrets locally.
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_STORE_NAME=Talomart Stores
AUTH_SECRET=replace-with-a-random-local-secret-at-least-48-characters
ADMIN_MFA_REQUIRED=true

DATABASE_URL=postgresql://talomart:talomart@localhost:5432/talomart
DATABASE_DIRECT_URL=postgresql://talomart:talomart@localhost:5432/talomart
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=product-images

MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/api/payments/mpesa/callback

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=Talomart Stores <accounts@example.com>
EMAIL_REPLY_TO=
CRON_SECRET=
RATE_LIMIT_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_IPS=
LOG_LEVEL=debug
